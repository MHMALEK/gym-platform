# Full API origin (no trailing slash).
# iOS Simulator: http://127.0.0.1:8000
# Android Emulator: http://10.0.2.2:8000
# Physical device: http://<your-lan-ip>:8000
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000

# Dev client login — uses Bearer token "dev-client" (backend DEV_BYPASS_AUTH=true).
EXPO_PUBLIC_DEV_AUTH=true

# Optional coach invite for first dev signup (from web Settings → Branding).
EXPO_PUBLIC_DEV_INVITE_CODE=

# Firebase (production). Optional if using dev login only.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
